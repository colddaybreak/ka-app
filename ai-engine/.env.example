# === AI Engine Environment ===
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://kb_user:kb_pass@localhost:5432/knowledge_base
REDIS_URL=redis://localhost:6379

# Internal Auth (must match api-gateway's INTERNAL_API_TOKEN)
INTERNAL_API_TOKEN=your-internal-token-change-in-production

# LLM / Embedding（OpenAI 兼容接口）
# 默认对接阿里云百炼 DashScope，对话模型为 deepseek-v4-flash：
#   API Key 在百炼控制台获取（https://bailian.console.aliyun.com），以 sk- 开头
#   注意：API Key 需与 base_url 所在地域匹配
# 如需改用 OpenAI 官方：
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o / EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-your-dashscope-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
# 思考模式开启后输出更长，上限需预留足够空间
MAX_TOKENS=4096
# 思考模式：DeepSeek V4 系列默认开启思考模式，本项目亦默认开启（回答前先行推理，质量更高）。
# 如追求更快的首字响应，可改为 false 关闭。
# 可选值：true / false；留空则不传该参数（使用模型默认行为）。
# 注意：切换回 OpenAI 官方端点时请注释掉本行，官方 API 不识别该参数
ENABLE_THINKING=true

# Embedding（text-embedding-v4 支持 1536 维，与 chunks 表结构一致；
# 修改维度时需同步修改 scripts/init_pgvector.sql 并重新向量化全部文档）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1536

# RAG
DEFAULT_TOP_K=10
DEFAULT_SIMILARITY_THRESHOLD=0.7
MAX_CONVERSATION_HISTORY=20

# File
UPLOAD_DIR=../api-gateway/uploads
